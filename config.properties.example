# Copie este arquivo para %USERPROFILE%\.lumi\config.properties
# se preferir não usar variáveis de ambiente (útil na versão instalada).
# Variáveis de ambiente têm prioridade. NUNCA coloque o arquivo de verdade no GitHub.

MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?appName=Cluster0
GROQ_API_KEY=gsk_sua_chave_aqui

# opcionais
# MONGODB_DATABASE=lumi
# GROQ_MODEL=llama-3.3-70b-versatile

# opcional: enviar o código de recuperação de senha por e-mail (ex.: Gmail com senha de app)
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=seu.email@gmail.com
# spring.mail.password=senha_de_app
